{
	"name": "ultimate-post-kit",
	"version": "4.5.2",
	"main": "index.php",
	"scripts": {
		"build": "npm run && npm run clean && cross-env NODE_ENV=production grunt",
			"clean": "rimraf ./assets",
			"dev": "cross-env NODE_ENV=development grunt watch",
			"zip": "npm run && npm run clean && cross-env NODE_ENV=production grunt && rsync -av --exclude-from=.buildignore . ultimate-post-kit && zip -r ultimate-post-kit-v.$npm_package_version.zip ultimate-post-kit/* && rm -rf ultimate-post-kit"
	},
	"keywords": [
		"ultimate-post-kit",
		"theme"
	],
	"author": "bdthemes",
	"license": "ISC",
	"devDependencies": {
		"cross-env": "^7.0.3",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-jquery": "^1.5.1",
		"eslint-plugin-prettier": "^5.0.0",
		"goodshare.js": "^6.3.0",
		"grunt": "^1.6.1",
		"grunt-contrib-concat": "^2.1.0",
		"grunt-contrib-copy": "^1.0.0",
		"grunt-contrib-watch": "^1.1.0",
		"grunt-rtlcss": "^2.0.2",
		"grunt-sass": "^3.1.0",
		"grunt-terser": "^2.0.0",
		"jquery": "^3.7.0",
		"prettier": "^3.0.2",
		"rimraf": "^5.0.1",
		"terser": "^5.30.3",
		"uikit": "3.17.1"
	},
	"dependencies": {
		"sass": "^1.72.0"
	}
}
